generator client {
  provider = "prisma-client-js"
}

// Default: PostgreSQL (Vercel / Docker / AWS RDS)
// For MySQL / Hostinger: change provider to "mysql" and update DATABASE_URL
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactInquiry {
  id             String   @id @default(cuid())
  fullName       String
  companyName    String
  email          String
  phone          String
  materialGrade  String
  thickness      String
  quantity       String
  specifications String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
  @@map("contact_inquiries")
}

enum EnquiryType {
  RFQ
  STOCK
}

enum EnquiryStatus {
  RECEIVED
  UNDER_REVIEW
  QUOTATION_PREPARED
  QUOTATION_SENT
  AWAITING_CONFIRMATION
  ORDER_CONFIRMED
  PROCESSING
  DISPATCHED
  COMPLETED
}

model Enquiry {
  id               String              @id @default(cuid())
  reference        String              @unique
  type             EnquiryType
  status           EnquiryStatus       @default(RECEIVED)
  companyName      String
  contactName      String
  email            String
  phone            String
  gstNumber        String?
  deliveryLocation String?
  requiredBy       DateTime?
  services         Json
  details          Json
  notes            String?             @db.Text
  erpReference     String?
  erpSyncedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  attachments      EnquiryAttachment[]
  events           EnquiryEvent[]

  @@index([email])
  @@index([createdAt])
  @@map("enquiries")
}

model EnquiryAttachment {
  id        String   @id @default(cuid())
  enquiryId String
  fileName  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([enquiryId])
  @@map("enquiry_attachments")
}

model EnquiryEvent {
  id        String        @id @default(cuid())
  enquiryId String
  status    EnquiryStatus
  note      String?
  createdAt DateTime      @default(now())
  enquiry   Enquiry       @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([enquiryId])
  @@map("enquiry_events")
}
