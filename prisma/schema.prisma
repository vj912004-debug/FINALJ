generator client {
  provider = "prisma-client-js"
}

// Default: PostgreSQL (Vercel / Docker / AWS RDS)
// For MySQL / Hostinger: change provider to "mysql" and update DATABASE_URL
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactInquiry {
  id             String   @id @default(cuid())
  fullName       String
  companyName    String
  email          String
  phone          String
  materialGrade  String
  thickness      String
  quantity       String
  specifications String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
  @@map("contact_inquiries")
}
