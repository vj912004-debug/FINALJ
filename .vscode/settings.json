{
  "css.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore",
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "search.exclude": {
    "**/.next": true,
    "**/node_modules": true,
    "**/uploads": true
  },
  "tailwindCSS.includeLanguages": {
    "typescript": "javascript",
    "typescriptreact": "javascript"
  },
  "tailwindCSS.classAttributes": ["className", "class"],
  "tailwindCSS.experimental.configFile": "src/app/globals.css",
  "tailwindCSS.validate": false,
  "tailwindCSS.lint.cssConflict": "ignore",
  "tailwindCSS.lint.invalidApply": "ignore",
  "tailwindCSS.lint.invalidScreen": "ignore",
  "tailwindCSS.lint.invalidVariant": "ignore",
  "tailwindCSS.lint.invalidConfigPath": "ignore",
  "tailwindCSS.lint.invalidTailwindDirective": "ignore",
  "tailwindCSS.lint.recommendedVariantOrder": "ignore",
  "tailwindCSS.lint.suggestCanonicalClasses": "ignore",
  "cSpell.enabled": false,
  "cSpell.import": ["./cspell.json"],
  "cSpell.enableFiletypes": ["typescript", "typescriptreact", "javascript", "javascriptreact", "markdown", "css", "json", "jsonc"],
  "cSpell.diagnosticLevel": "Hint",
