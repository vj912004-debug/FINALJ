# Environment
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Database — PostgreSQL (default). Required for saving enquiries, drawings and tracking.
# Local Docker Compose:
DATABASE_URL="postgresql://jagdamba:jagdamba@db:5432/jagdamba_profile?schema=public"

# MySQL alternative (Hostinger / shared hosting):
# DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Email notifications via Resend (https://resend.com). Leave blank to disable.
# ENQUIRY_FROM_EMAIL must be a sender on a domain verified in Resend.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL="Jagdamba Procut <enquiry@your-domain.com>"
# Comma-separated; defaults to the company email in src/data/site.ts
SALES_NOTIFY_EMAIL=
# "true" to email customers an acknowledgement with their reference number
SEND_CUSTOMER_ACK=false

# Optional webhook (Slack / Teams / n8n / Zapier) that receives { reference, text } for each enquiry
SALES_WEBHOOK_URL=

# Bearer token for PATCH /api/enquiries/{reference}/status (sales team / ERP). Min 24 characters.
ENQUIRY_ADMIN_TOKEN=

# Future ERP integration (server-side only — never exposed to the browser)
ERP_API_URL=
ERP_API_KEY=

# SEO
# Public site address used for canonical URLs, sitemap and structured data (no trailing slash).
# Defaults to the Vercel production URL. Set this when you connect a custom domain.
NEXT_PUBLIC_SITE_URL=
# Verification codes from Google Search Console / Bing Webmaster Tools (HTML-tag method, content value only)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# App
PORT=3000
